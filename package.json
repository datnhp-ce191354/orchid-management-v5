{
  "name": "orchid-management-v5",
  "version": "1.0.0",
  "description": "Orchid Management V5 - Spring Boot 3 API & React Vite",
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "mvn -f chapter15api/pom.xml spring-boot:run",
    "client": "npm --prefix chapter15reactjs run dev",
    "install:all": "npm install && npm --prefix chapter15reactjs install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
